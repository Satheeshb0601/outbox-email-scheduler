{
  "name": "outbox-backend",
  "version": "1.0.0",
  "description": "Email Job Scheduler Backend - BullMQ + Express + PostgreSQL",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:embedded": "ts-node-dev --respawn --transpile-only src/dev-server.ts",
    "migrate": "ts-node src/db/migrate.ts",
    "worker": "node dist/workers/emailWorker.js",
    "worker:dev": "ts-node-dev --respawn --transpile-only src/workers/emailWorker.ts"
  },
  "dependencies": {
    "@bull-board/api": "^5.13.0",
    "@bull-board/express": "^5.13.0",
    "@elastic/elasticsearch": "^8.13.0",
    "axios": "^1.6.8",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.4.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "ioredis": "^5.3.2",
    "ioredis-mock": "^8.13.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.11.5",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "@types/passport": "^1.0.16",
    "@types/passport-google-oauth20": "^2.0.14",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.11.5",
    "@types/uuid": "^9.0.8",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
